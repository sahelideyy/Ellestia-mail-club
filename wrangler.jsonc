
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ellestia-mail-club",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ellestia-mail-club-db",
      "database_id": "e9224dcf-af33-4429-bd59-cdc3b80d98dc",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "f634ac99-b076-480b-809d-f64bb46bd1d8"
      }
    ]
  }
,
"observability": {
  "enabled": true,
  "logs": {
    "enabled": true,
    "invocation_logs": true,
    "persist": true
  }
}
}
